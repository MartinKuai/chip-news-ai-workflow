GEMINI_API_KEY=your_gemini_api_key

WRITER_MODEL=your_writer_model
REVIEWER_MODEL=your_reviewer_model

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

ARTICLES_PER_FEED=2
MAX_REVISIONS=1

# Generation quality (optional, defaults shown)
WRITER_THINKING_LEVEL=medium
REVIEWER_THINKING_LEVEL=low
WRITER_MAX_OUTPUT_TOKENS=16384
REVIEWER_MAX_OUTPUT_TOKENS=8192
ARTICLE_CONTENT_CHARS=16000

# Gemini client resilience (optional, defaults shown)
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_ATTEMPTS=5
GEMINI_CALL_BUDGET_SECONDS=240
GEMINI_STRUCTURED_OUTPUT=1

# Run-level service health and budget (optional, defaults shown)
GEMINI_HEALTH_WINDOW=5
GEMINI_HEALTH_THRESHOLD=3
RUN_BUDGET_SECONDS=2100
