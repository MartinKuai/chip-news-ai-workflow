GEMINI_API_KEY=your_gemini_api_key

RESEARCHER_MODEL=your_researcher_model
WRITER_MODEL=your_writer_model
REVIEWER_MODEL=your_reviewer_model

# Website publishing (default channel): github | local (dry-run) | off
# Local runs default to a dry-run into SITE_LOCAL_DIR; github needs the token.
SITE_PUBLISH_MODE=local
SITE_REPO_TOKEN=your_site_repo_token
# SITE_REPO=MartinKuai/martinkuai
# SITE_REPO_BRANCH=main
# SITE_NEWS_DIR=data/news
# SITE_LOCAL_DIR=output/site
# SITE_TIMEOUT_SECONDS=20
# SITE_STATS_SINCE=2026-01
# SITE_STATS_WORKFLOW=daily_news.yml

# Telegram is off by default; PUBLISH_TELEGRAM=1 needs both values below.
PUBLISH_TELEGRAM=0
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Candidate selection
# SOURCE_FEEDS=https://www.eetimes.com/feed/,https://semiengineering.com/feed/
ARTICLES_PER_FEED=2
MAX_CANDIDATES_PER_RUN=6
MAX_CANDIDATE_AGE_HOURS=72
MAX_REVISIONS=1
ARTICLE_CONTENT_CHARS=12000

# Generation quality per node (optional, defaults shown)
RESEARCHER_THINKING_LEVEL=low
WRITER_THINKING_LEVEL=low
REVIEWER_THINKING_LEVEL=low
RESEARCHER_MAX_OUTPUT_TOKENS=3072
WRITER_MAX_OUTPUT_TOKENS=2560
REVIEWER_MAX_OUTPUT_TOKENS=1024

# Gemini client resilience (optional, defaults shown)
GEMINI_TIMEOUT_SECONDS=180
GEMINI_MAX_ATTEMPTS=5
GEMINI_CALL_BUDGET_SECONDS=240
GEMINI_STRUCTURED_OUTPUT=1

# Circuit breaker and run time budget (optional, defaults shown)
BREAKER_WINDOW=5
BREAKER_THRESHOLD=3
RUN_BUDGET_SECONDS=2100

# Publishing and notification (optional, defaults shown)
# PUBLISH_ENABLED=0 publishes nothing externally (website switches to local).
PUBLISH_ENABLED=1
TELEGRAM_TIMEOUT_SECONDS=15
# RUN_SUMMARY_PATH=output/run-summary.json
# All nodes/retries/repairs share per-model pacing and Pacific-day reservations.
GEMINI_MIN_INTERVAL_SECONDS=15
GEMINI_DAILY_REQUEST_LIMIT=18
GEMINI_QUOTA_LEDGER_PATH=gemini-quota-ledger.json
# Local first use can initialize a ledger; Actions requires a restored file.
GEMINI_QUOTA_LEDGER_REQUIRED=0
