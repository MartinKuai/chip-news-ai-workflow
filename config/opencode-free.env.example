# Reproduction-only trial. Direct API and isolated CLI returned FreeTierError
# (HTTP 403) in the 2026-10-21 probe. NOT a verified production configuration.
# Official docs describe public free calls; actual service behavior differed.
# Model availability and free campaigns must be rechecked before enabling.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://opencode.ai/inference/openai/v1
LLM_AUTH_MODE=none
LLM_ALLOWED_MODELS=deepseek-v4.1-flash-free,glm-5.3-flash-free
RESEARCHER_MODEL=deepseek-v4.1-flash-free
WRITER_MODEL=deepseek-v4.1-flash-free
REVIEWER_MODEL=glm-5.3-flash-free
LLM_FALLBACK_MODELS=deepseek-v4.1-flash-free,glm-5.3-flash-free
LLM_RESPONSE_FORMAT=json_object
LLM_MAX_ATTEMPTS=2
LLM_TIMEOUT_SECONDS=120
LLM_CALL_BUDGET_SECONDS=240
LLM_MIN_INTERVAL_SECONDS=2
SITE_PUBLISH_MODE=local
SITE_LOCAL_DIR=output/opencode-free
PUBLISH_TELEGRAM=0
