# Replace the placeholders with a provider/model you have verified.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.example.com/v1
LLM_AUTH_MODE=bearer
LLM_API_KEY=your_provider_api_key
LLM_ALLOWED_MODELS=your_model_id
RESEARCHER_MODEL=your_model_id
WRITER_MODEL=your_model_id
REVIEWER_MODEL=your_model_id
# Optional. Every fallback must also appear in LLM_ALLOWED_MODELS.
LLM_FALLBACK_MODELS=
LLM_RESPONSE_FORMAT=json_object
SITE_PUBLISH_MODE=local
SITE_LOCAL_DIR=output/compatible-site
PUBLISH_TELEGRAM=0
